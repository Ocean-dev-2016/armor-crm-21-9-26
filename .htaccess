RewriteEngine On

# Allow Authorization Header for Bearer Token
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# API Routes
RewriteRule ^api/v1/([^/]+)(\.php)?/?$ api/app.php?action=$1 [L,QSA]

# Login
RewriteRule ^login/?$ login.php [L,QSA]

# Logout
RewriteRule ^logout/?$ logout.php [L,QSA]

# Dashboard (Company Admin & Users)
RewriteRule ^dashboard/?$ dashboard.php [L,QSA]
RewriteRule ^user-dashboard/?$ user_dashboard.php [L,QSA]

# Master Route
RewriteRule ^category/?$ admin/master/category/list.php [L]
RewriteRule ^sub-category/?$ admin/master/sub-category/list.php [L]
RewriteRule ^department/?$ admin/master/department/list.php [L]
RewriteRule ^designation/?$ admin/master/designation/list.php [L]
RewriteRule ^tax/?$ admin/master/tax/list.php [L]
RewriteRule ^variant/?$ admin/master/variant/list.php [L]
RewriteRule ^unit/?$ admin/master/unit/list.php [L]
RewriteRule ^product/?$ admin/master/product/list.php [L]
RewriteRule ^product/add/?$ admin/master/product/form.php [L]
RewriteRule ^product/edit/([^/]+)/?$ admin/master/product/form.php?id=$1 [L]
RewriteRule ^followup-reason/?$ admin/master/followup-reason/list.php [L]
RewriteRule ^industry-type/?$ admin/master/industry-type/list.php [L]
RewriteRule ^company-type/?$ admin/master/company-type/list.php [L]
RewriteRule ^brand/?$ admin/master/brand/list.php [L]
RewriteRule ^customer-type/?$ admin/master/customer-type/list.php [L]
RewriteRule ^customer-followup-reason/?$ admin/master/customer-followup-reason/list.php [L]

# Sub Master
RewriteRule ^country/?$ admin/submaster/country/list.php [L]
RewriteRule ^state/?$ admin/submaster/state/list.php [L]
RewriteRule ^city/?$ admin/submaster/city/list.php [L]
RewriteRule ^expense-category/?$ admin/submaster/expense-category/list.php [L]
RewriteRule ^leave-type/?$ admin/submaster/leave-type/list.php [L]
RewriteRule ^complain-category/?$ admin/submaster/complain-category/list.php [L]
RewriteRule ^complain-sub-category/?$ admin/submaster/complain-sub-category/list.php [L]
RewriteRule ^source-of-inquiry/?$ admin/submaster/source-of-inquiry/list.php [L]
RewriteRule ^transport-by/?$ admin/submaster/transport-by/list.php [L]
RewriteRule ^transporter-detail/?$ admin/submaster/transporter-detail/list.php [L]
RewriteRule ^dispatch-order-status/?$ admin/submaster/dispatch-order-status/list.php [L]
RewriteRule ^visit-purpose/?$ admin/submaster/visit-purpose/list.php [L]
RewriteRule ^terms-condition/?$ admin/submaster/terms-condition/list.php [L]
RewriteRule ^zone/?$ admin/submaster/zone/list.php [L]
RewriteRule ^marketing-status/?$ admin/submaster/marketing-status/list.php [L,QSA]


# Module
RewriteRule ^module/?$ admin/setting/module/list.php [L]

# Platform Leads (Superadmin Only)
RewriteRule ^lead/?$ admin/setting/lead/list.php [L,QSA]
RewriteRule ^lead/add/?$ admin/setting/lead/form.php [L,QSA]
RewriteRule ^lead/view/([^/]+)/?$ admin/setting/lead/view.php?id=$1 [L,QSA]
RewriteRule ^lead/edit/([^/]+)/?$ admin/setting/lead/form.php?id=$1 [L,QSA]
RewriteRule ^lead/followup-history/([^/]+)/?$ admin/setting/lead/followup-history.php?id=$1 [L,QSA]
RewriteRule ^lead/followup-history/?$ admin/setting/lead/followup-history.php [L,QSA]
RewriteRule ^leads/?$ admin/setting/lead/list.php [L,QSA]
RewriteRule ^leads/add/?$ admin/setting/lead/form.php [L,QSA]
RewriteRule ^leads/edit/([^/]+)/?$ admin/setting/lead/form.php?id=$1 [L,QSA]
RewriteRule ^saas-leads/?$ admin/setting/lead/list.php [L,QSA]
RewriteRule ^saas-leads/add/?$ admin/setting/lead/form.php [L,QSA]
RewriteRule ^saas-leads/edit/([^/]+)/?$ admin/setting/lead/form.php?id=$1 [L,QSA]

# Lead Status
RewriteRule ^lead-status/?$ admin/setting/lead-status/list.php [L]

# Lead Source of Inquiry
RewriteRule ^lead-source-of-inquiry/?$ admin/setting/lead-source-of-inquiry/list.php [L]

# Lead Employee
RewriteRule ^lead-employee/?$ admin/setting/lead-employee/list.php [L]

# Lead Followup Type
RewriteRule ^lead-followup-type/?$ admin/setting/lead-followup-type/list.php [L]

# Plan
RewriteRule ^plan/?$ admin/setting/plan/list.php [L]
RewriteRule ^plan/add/?$ admin/setting/plan/form.php [L]
RewriteRule ^plan/edit/([^/]+)/?$ admin/setting/plan/form.php?id=$1 [L]

# Company
RewriteRule ^company/?$ admin/setting/company/list.php [L,QSA]
RewriteRule ^company/add/?$ admin/setting/company/form.php [L,QSA]
RewriteRule ^company/edit/([^/]+)/?$ admin/setting/company/form.php?id=$1 [L,QSA]

# Team Role
RewriteRule ^teamrole/?$ admin/setting/teamrole/list.php [L]
RewriteRule ^teamrole/setting/([^/]+)/?$ admin/setting/teamrole/setting.php?id=$1 [L]

# Team Person
RewriteRule ^team-person/?$ admin/setting/team-person/list.php [L]
RewriteRule ^team-person/add/?$ admin/setting/team-person/form.php [L]
RewriteRule ^team-person/edit/([^/]+)/?$ admin/setting/team-person/form.php?id=$1 [L]

# Company Lead
RewriteRule ^company-lead/?$ admin/setting/company-lead/list.php [L,QSA]
RewriteRule ^company-lead/add/?$ admin/setting/company-lead/form.php [L,QSA]
RewriteRule ^company-lead/view/([^/]+)/?$ admin/setting/company-lead/view.php?id=$1 [L,QSA]
RewriteRule ^company-lead/edit/([^/]+)/?$ admin/setting/company-lead/form.php?id=$1 [L,QSA]
RewriteRule ^company-lead-followup/?$ admin/setting/company-lead/followup-list.php [L,QSA]
# Customer (Sales & Marketing)
RewriteRule ^customer/?$ admin/sales/customer/list.php [L,QSA]
RewriteRule ^customer/add/?$ admin/sales/customer/form.php [L,QSA]
RewriteRule ^customer/edit/([^/]+)/?$ admin/sales/customer/form.php?id=$1 [L,QSA]
RewriteRule ^customer/lead-history/([^/]+)/?$ admin/sales/customer/lead-history.php?customer_id=$1 [L,QSA]
RewriteRule ^customer-followup/?$ admin/sales/customer-followup/list.php [L,QSA]

# Profile
RewriteRule ^profile/?$ profile.php [L]
RewriteRule ^profile/edit/?$ profile.php?action=edit [L]

# Existing Files / Folders
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]